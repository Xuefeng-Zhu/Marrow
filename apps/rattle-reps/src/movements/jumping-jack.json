{
  "version": 1,
  "id": "jumping-jack",
  "name": "Jumping jack",
  "minVisibility": 0.5,
  "hysteresis": 5,
  "minRepMs": 400,
  "metrics": {
    "feetGap": { "kind": "distance", "points": ["leftAnkle", "rightAnkle"] },
    "armHeight": { "kind": "offset", "points": ["leftWrist", "leftShoulder"], "axis": "y" }
  },
  "phases": [
    { "id": "closed", "metric": "feetGap", "min": 0, "max": 0.7 },
    { "id": "open", "metric": "feetGap", "min": 1.3, "max": 3 }
  ],
  "formRules": [
    {
      "id": "arms-low",
      "metric": "armHeight",
      "max": -0.4,
      "phases": ["open"],
      "debounceMs": 300,
      "message": "Reach overhead"
    },
    {
      "id": "feet-narrow",
      "metric": "feetGap",
      "min": 1.4,
      "phases": ["open"],
      "debounceMs": 300,
      "message": "Jump wider"
    }
  ]
}
