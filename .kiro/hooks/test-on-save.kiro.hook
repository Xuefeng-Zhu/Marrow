{
  "enabled": true,
  "name": "Test on save",
  "description": "Run related vitest tests when source files change and fix failures.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["packages/**/src/**/*.ts", "apps/**/src/**/*.ts", "apps/**/src/**/*.tsx"] },
  "then": { "type": "askAgent", "prompt": "A source file was edited. Find the related vitest tests (colocated *.test.ts/tsx or the module's tests) and run them with 'npx vitest run <files>' in the right workspace. If any fail, fix the cause, preferring code fixes over weakening tests. Report what you ran." }
}
